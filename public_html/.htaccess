Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Маршруты админки описаны здесь, а не в public_html/admin/.htaccess:
    # свои правила в подкаталоге отменяют правила корня целиком, и тогда
    # /admin без слэша до mod_rewrite вообще не доходит — слэш добавляет
    # сам Apache, а за обратным прокси он строит переадресацию по http://.
    # Страница и форма оказываются на разных источниках, и браузер
    # блокирует вход правилом form-action.
    RewriteCond %{HTTP:X-Forwarded-Proto} =https
    RewriteRule ^admin$ https://%{HTTP_HOST}/admin/ [R=301,L]
    RewriteRule ^admin$ /admin/ [R=301,L]

    # Внутри админки существующие файлы отдаём как есть, остальное — её
    # фронт-контроллеру. Каталог назван и здесь, и в config.php (admin_path):
    # переименуете админку — поправьте оба правила выше и это.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^admin/ admin/index.php [QSA,L]

    # Реальные файлы и каталоги отдаём как есть
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Всё остальное — во фронт-контроллер
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Каталог приложения недоступен из веба, если лежит внутри public_html
<IfModule mod_alias.c>
    RedirectMatch 404 ^/app(/|$)
</IfModule>

# За обратным прокси Apache видит обычный http и строит редиректы на http://.
# Браузер тогда считает, что страница и форма живут на разных источниках,
# и блокирует отправку по правилу form-action 'self'.
#
# Каждая директива обёрнута проверкой модуля: на урезанном хостинге
# незнакомая строка в .htaccess роняет весь сайт в 500.
<IfModule mod_setenvif.c>
    SetEnvIf X-Forwarded-Proto "^https$" HTTPS=on
    SetEnvIf X-Forwarded-Proto "^https$" BEHIND_TLS=1
</IfModule>

<IfModule mod_headers.c>
    # Возвращаем схему на место в адресе переадресации
    Header always edit Location "^http://" "https://" env=BEHIND_TLS

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Политику задаёт PHP (bootstrap.php): в неё добавляются домены
    # счётчиков, включённых в админке. Здесь оставлять нельзя — .htaccess
    # о настройках не знает.

    # Версия PHP наружу не нужна
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>

AddDefaultCharset UTF-8
