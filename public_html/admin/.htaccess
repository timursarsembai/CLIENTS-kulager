Options -Indexes -MultiViews
DirectoryIndex index.php

# Маршрутизация админки живёт в public_html/.htaccess: правила mod_rewrite,
# заданные в подкаталоге, отменяют правила корня и ломают обработку /admin.


<IfModule mod_setenvif.c>
    SetEnvIf X-Forwarded-Proto "^https$" HTTPS=on
    SetEnvIf X-Forwarded-Proto "^https$" BEHIND_TLS=1
</IfModule>

<IfModule mod_headers.c>
    # Переадресация админки тоже должна оставаться на https
    Header always edit Location "^http://" "https://" env=BEHIND_TLS

    # Админку не индексируем и не показываем во фреймах
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always unset X-Powered-By

    # Политику админки задаёт PHP: там свой одноразовый ключ для inline-скриптов.
    # Унаследованную от сайта снимаем, иначе браузер применит обе разом.
    Header always unset Content-Security-Policy
</IfModule>
