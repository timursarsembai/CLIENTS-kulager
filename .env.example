# Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
#
# Файл .env в репозиторий не попадает — в нём пароли конкретной установки.

KULAGER_DB_USER=kulager
KULAGER_DB_PASS=смените-этот-пароль
KULAGER_DB_ROOT_PASS=смените-и-этот-тоже

# Тексты ошибок посетителям: 1 только для отладки на своей машине
KULAGER_DEBUG=0

# Адреса обратных прокси через запятую — им доверяем определение адреса
# посетителя. Локально это адрес контейнера nginx-proxy-manager; на обычном
# хостинге без прокси строка остаётся пустой.
KULAGER_TRUSTED_PROXIES=172.18.0.2
